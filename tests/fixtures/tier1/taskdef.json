{"family": "web", "containerDefinitions": [
  {"name": "app", "image": "nginx", "memory": 128,
   "environment": [{"name": "LOG_LEVEL", "value": "info"},
                   {"name": "SLACK_TOKEN", "value": "{{CANARY:ecs}}"},
                   {"name": "DB_PASSWORD", "value": "{{PASSWORD:ecs}}"}],
   "secrets": [{"name": "API_KEY", "valueFrom": "arn:aws:ssm:eu-west-1:123456789012:parameter/api"}]}]}
